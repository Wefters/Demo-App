# Copy to backend/.env to change the defaults. The app reaches the backend through the Vite dev server
# (vite.config.ts forwards /api), so these only matter when you change the port or call it directly.

# Port the API listens on. Keep it in step with API_PROXY_TARGET in the app if you change it.
PORT=4000

# 127.0.0.1 keeps the mock server private to this machine. Use 0.0.0.0 to reach it directly from a
# device on the same network (then set VITE_API_URL=http://<this machine's IP>:4000/api in the app).
HOST=127.0.0.1
