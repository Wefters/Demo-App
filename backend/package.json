{
  "name": "demo-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Local test API for the Wefter Demo App: echo, a mock OAuth 2.0 server and deep link test pages.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test test/*.test.ts",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.3"
  }
}
