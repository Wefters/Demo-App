# Settings for the demo app. Copy the ones you need to .env.local (git-ignored); see src/config/api.ts.

# Full URL of the demo backend. Leave it unset during `wefter run <platform> --watch`: the app then calls
# /api on the dev server, which forwards it to the backend. Set it for builds without the dev server, or
# for a backend elsewhere, for example a tunnel: VITE_API_URL=https://my-tunnel.example.com/api
VITE_API_URL=

# Where the dev server forwards /api (vite.config.ts). Change it with PORT in backend/.env.
API_PROXY_TARGET=http://127.0.0.1:4000
