{
  "plugins": [
    "@wefterjs/app",
    "@wefterjs/biometric",
    "@wefterjs/browser",
    "@wefterjs/flash-light",
    "@wefterjs/scanner",
    "@wefterjs/secure-storage",
    "@wefterjs/storage",
    "@wefterjs/haptics",
    "@wefterjs/dialog",
    "@wefterjs/network",
    "@wefterjs/clipboard",
    "@wefterjs/device",
    "@wefterjs/screen",
    "@wefterjs/share",
    "@wefterjs/error-test"
  ],
  "pluginsDir": "node_modules",
  "webDir": "dist",
  "pluginConfig": {},
  "environments": {
    "development": {
      "appId": "dev.sandip.wefter.demo",
      "appName": "Wefter Demo"
    },
    "production": {
      "appId": "com.wefter.demo",
      "appName": "Wefter"
    }
  },
  "launchBackground": "#111314",
  "splash": {
    "source": "splash",
    "minDuration": 800,
    "maxDuration": 5000,
    "dismissOn": "ready",
    "transition": "fade"
  },
  "deepLinks": {
    "schemes": ["wefterdemo"]
  },
  "permissions": {
    "camera": "The demo shows your camera on the Web APIs page and lets you take photos to upload.",
    "microphone": "The demo shows your microphone level on the Web APIs page.",
    "location": "The demo shows where you are on the Web APIs page."
  }
}
